#!/bin/bash
set -eu
cd $(dirname $(realpath $0))

image=filefrog/dproxy:3
if [ -f .image ]; then
  image=$(cat .image | head -n1)
fi
if [ -n "${DPROXY_IMAGE:-}" ]; then
  image=$DPROXY_IMAGE
fi

name=${DPROXY_NAME:-dproxy}
http_port=${DPROXY_HTTP_PORT:-80}
https_port=${DPROXY_HTTPS_PORT:-443}
network=${DPROXY_NETWORK:-host}

if [ -n "${DPROXY_BACKEND_HOST:-}" ]; then
  backend_host=$DPROXY_BACKEND_HOST
elif [ "$network" = "bridge" ]; then
  backend_host=host.docker.internal
else
  backend_host=127.0.0.1
fi

proxy_defaults() {
  docker run --rm $image \
    cat /opt/proxy.defaults
}

dump_docker() {
  docker exec $name dump-docker
}

dump_nginx() {
  docker exec -i $name nginx -T
}

reconfigure_nginx() {
  docker exec -i $name reconfigure-nginx
}

reload_nginx() {
  docker exec -i $name reload-nginx
}

CMD=${1:-help}
case $CMD in
help)
  cat >&2 <<EOF
dproxy - A controller utility for dproxy HTTPS routing

The following commands are understood:

  status   - Show current status: routes, cert, config, event log.
  list, ls - Alias for status.
  check    - Force an immediate reconfigure (routes update automatically).
  dump     - Dump the raw route JSON from running containers.

  stop     - Shuts down the dproxy container.
  start    - Starts up the dproxy container.
  restart  - Shuts down the dproxy container and starts it back up.
  reload   - Reload the nginx configuration.

  nginx    - Run nginx -T for lower-level debugging of route config.
  update   - Pulls the latest dproxy Docker image and restarts.

  help     - Print this screen and exit.

Environment variables (set before calling start):
  DPROXY_NAME         - Container name (default: dproxy); set to run multiple instances
  DPROXY_HTTP_PORT    - HTTP listen port (default: 80)
  DPROXY_HTTPS_PORT   - HTTPS listen port (default: 443)
  DPROXY_NETWORK      - Network mode: host (default) or bridge
  DPROXY_BACKEND_HOST - Upstream host for routed containers
                        (default: 127.0.0.1 for host mode, host.docker.internal for bridge)
  DPROXY_CERT              - Path to TLS certificate (default: ./dproxy.cert)
  DPROXY_KEY               - Path to TLS private key (default: ./dproxy.key)
  DPROXY_ACME_DOMAIN       - Enable ACME; issues *.DOMAIN automatically
  DPROXY_ACME_PROVIDER     - acme.sh DNS provider slug (e.g. cf, aws, dgon)
  DPROXY_ACME_EMAIL        - Account email for Let's Encrypt notifications
  DPROXY_ACME_CA           - ACME CA (default: letsencrypt)
  DPROXY_DOMAIN            - Root domain; short route labels expand to name.DOMAIN
  DPROXY_PREFIX            - Docker label prefix (default: com.huntprod.docker)
  DPROXY_IMAGE             - Override the Docker image to use

ACME provider credentials go in acme.env (gitignored), e.g. CF_Token=xxx

EOF
  exit 0
  ;;

update)
  docker pull $image
  $0 restart
  ;;

restart)
  $0 stop && \
  $0 start
  ;;

stop)
  docker stop $name
  docker rm $name
  ;;

start)
  if [[ ! -f $PWD/proxy.defaults ]]; then
    proxy_defaults >$PWD/proxy.defaults
  fi

  docker stop $name 2>/dev/null || true
  docker rm   $name 2>/dev/null || true

  docker_args=(
    -d
    --restart=always
    --name "$name"
    -l "com.huntprod.docker.local.pwd=$PWD"
    -v /var/run/docker.sock:/var/run/docker.sock:ro
    -v "$PWD/proxy.defaults:/etc/nginx/proxy.defaults:ro"
    -e "HTTP_PORT=$http_port"
    -e "HTTPS_PORT=$https_port"
    -e "BACKEND_HOST=$backend_host"
  )

  if [ "$network" = "host" ]; then
    docker_args+=( --network host )
  else
    docker_args+=(
      -p "${http_port}:${http_port}"
      -p "${https_port}:${https_port}"
      --add-host=host.docker.internal:host-gateway
    )
  fi

  if [ -n "${DPROXY_ACME_DOMAIN:-}" ]; then
    if [ -z "${DPROXY_ACME_PROVIDER:-}" ]; then
      echo >&2 "DPROXY_ACME_PROVIDER is required when DPROXY_ACME_DOMAIN is set"
      exit 1
    fi
    mkdir -p "$PWD/acme/live"
    docker_args+=(
      -v "$PWD/acme:/var/lib/acme"
      -e "ACME_DOMAIN=$DPROXY_ACME_DOMAIN"
      -e "ACME_PROVIDER=$DPROXY_ACME_PROVIDER"
      -e "TLS_CERT=/var/lib/acme/live/wildcard.crt"
      -e "TLS_KEY=/var/lib/acme/live/wildcard.key"
    )
    [ -n "${DPROXY_ACME_EMAIL:-}" ] && docker_args+=( -e "ACME_EMAIL=$DPROXY_ACME_EMAIL" )
    [ -n "${DPROXY_ACME_CA:-}"    ] && docker_args+=( -e "ACME_CA=$DPROXY_ACME_CA" )
    [ -f "$PWD/acme.env"          ] && docker_args+=( --env-file "$PWD/acme.env" )
  else
    if   [ -n "${DPROXY_CERT:-}" ] && [ -z "${DPROXY_KEY:-}" ]; then
      echo >&2 "DPROXY_CERT is set but DPROXY_KEY is not — this looks like a typo"
      exit 1
    elif [ -z "${DPROXY_CERT:-}" ] && [ -n "${DPROXY_KEY:-}" ]; then
      echo >&2 "DPROXY_KEY is set but DPROXY_CERT is not — this looks like a typo"
      exit 1
    fi
    cert=${DPROXY_CERT:-$PWD/dproxy.cert}
    key=${DPROXY_KEY:-$PWD/dproxy.key}
    if [[ ! -f $cert || ! -f $key ]]; then
      echo >&2 "TLS cert/key not found: $cert / $key"
      echo >&2 "Set DPROXY_CERT and DPROXY_KEY, or place files at the default paths."
      echo >&2 "Or use DPROXY_ACME_DOMAIN + DPROXY_ACME_PROVIDER for automatic certificates."
      exit 1
    fi
    docker_args+=(
      -v "$cert:/etc/nginx/tls/wildcard.crt:ro"
      -v "$key:/etc/nginx/tls/wildcard.key:ro"
    )
  fi

  [ -n "${DPROXY_DOMAIN:-}" ] && docker_args+=( -e "DPROXY_DOMAIN=$DPROXY_DOMAIN" )
  [ -n "${DPROXY_PREFIX:-}" ] && docker_args+=( -e "DPROXY_PREFIX=$DPROXY_PREFIX" )

  docker run "${docker_args[@]}" "$image"
  ;;

list|ls|status)
  docker exec $name cat /var/run/dproxy/status
  ;;

check)
  docker exec $name sh -c 'dump-docker | reconfigure-nginx'
  ;;

dump)
  dump_docker
  ;;

nginx)
  dump_nginx
  ;;

reload)
  reload_nginx
  ;;

*)
  if [ -d libexec -a -x libexec/dproxy-$CMD ]; then
    exec libexec/dproxy-$CMD "$@"
    exit 7
  fi
  echo >&2 "USAGE: $0 (start|stop|status|check|dump|restart|reload|update|nginx)"
  exit 1
  ;;
esac
