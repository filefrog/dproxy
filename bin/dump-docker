#!/bin/sh
set -eu
prefix=${DPROXY_PREFIX:-com.huntprod.docker}

for id in $(docker ps --filter label=${prefix}.route --format '{{.ID}}')
do
	docker inspect $id | \
	  jq -cr '
.[]
 | { id: .Id,
     config: (
       .Config.Labels
       | [
          to_entries
          | .[]
          | select(.key | contains("'$prefix'."))
          | {key:   (.key | gsub("^'$prefix'.";"")),
             value: .value}
         ]
       | from_entries
     )
   }
'
done | sort
