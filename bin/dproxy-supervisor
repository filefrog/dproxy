#!/usr/bin/python3
import datetime
import json
import os
import subprocess
import sys
import threading
import time

PREFIX   = os.getenv('DPROXY_PREFIX', 'com.huntprod.docker')
DEBOUNCE = float(os.getenv('DPROXY_DEBOUNCE', '0.5'))

DPROXY_DOMAIN = os.getenv('DPROXY_DOMAIN', '')
HTTP_PORT     = os.getenv('HTTP_PORT',     '80')
HTTPS_PORT    = os.getenv('HTTPS_PORT',    '443')
BACKEND_HOST  = os.getenv('BACKEND_HOST',  '127.0.0.1')

TLS_CERT = os.getenv('TLS_CERT', '/etc/nginx/tls/wildcard.crt')
TLS_KEY  = os.getenv('TLS_KEY',  '/etc/nginx/tls/wildcard.key')

ACME_DOMAIN          = os.getenv('ACME_DOMAIN',    '')
ACME_PROVIDER        = os.getenv('ACME_PROVIDER',  '')
ACME_EMAIL           = os.getenv('ACME_EMAIL',     '')
ACME_CA              = os.getenv('ACME_CA',        'letsencrypt')
ACME_HOME            = os.getenv('ACME_HOME',      '/var/lib/acme')
ACME_RENEW_INTERVAL  = int(os.getenv('ACME_RENEW_INTERVAL', str(12 * 3600)))

STATE_DIR    = os.getenv('STATE_DIR', '/var/run/dproxy')
STATUS_FILE  = os.path.join(STATE_DIR, 'status')
EVENTS_FILE  = os.path.join(STATE_DIR, 'events')
CONTROL_FILE = os.path.join(STATE_DIR, 'last.control')

TRIGGER_EVENTS = {'start', 'stop', 'die', 'kill', 'pause', 'unpause'}

_timer      = None
_lock       = threading.Lock()
_start_time = datetime.datetime.now(datetime.timezone.utc)


def log(msg):
    print(f'[dproxy] {msg}', flush=True)


# --- status + event log ---

def _now_str():
    return datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')


def log_event(msg):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(EVENTS_FILE, 'a') as f:
        f.write(f'{_now_str()}  {msg}\n')


def _cert_expiry():
    if not os.path.exists(TLS_CERT):
        return 'not found'
    try:
        r = subprocess.run(
            ['openssl', 'x509', '-noout', '-enddate', '-in', TLS_CERT],
            capture_output=True, text=True, timeout=5,
        )
        val = r.stdout.strip().split('=', 1)[1]   # notAfter=Sep 23 15:42:01 2026 GMT
        dt  = datetime.datetime.strptime(val, '%b %d %H:%M:%S %Y %Z')
        dt  = dt.replace(tzinfo=datetime.timezone.utc)
        days = (dt - datetime.datetime.now(datetime.timezone.utc)).days
        return f'{dt.strftime("%Y-%m-%d")} ({days} days)'
    except Exception:
        return 'unknown'


def write_status():
    os.makedirs(STATE_DIR, exist_ok=True)

    now     = datetime.datetime.now(datetime.timezone.utc)
    elapsed = now - _start_time
    total_s = int(elapsed.total_seconds())
    d, rem  = divmod(total_s, 86400)
    h, rem  = divmod(rem, 3600)
    m, s    = divmod(rem, 60)
    if d:
        uptime = f'{d}d {h}h {m}m'
    elif h:
        uptime = f'{h}h {m}m'
    else:
        uptime = f'{m}m {s}s'

    routes = []
    if os.path.exists(CONTROL_FILE):
        with open(CONTROL_FILE) as f:
            routes = [l.strip() for l in f if l.strip()]

    if ACME_DOMAIN:
        tls_mode = f'ACME  (*.{ACME_DOMAIN} via dns_{ACME_PROVIDER})'
    else:
        tls_mode = 'manual'

    events = []
    if os.path.exists(EVENTS_FILE):
        with open(EVENTS_FILE) as f:
            events = [l.rstrip() for l in f.readlines()[-20:]]

    domain_val = DPROXY_DOMAIN or '(not set — route labels must be fully-qualified)'

    out = [
        'dproxy status',
        '=' * 42,
        f'Updated: {now.strftime("%Y-%m-%d %H:%M:%S UTC")}',
        f'Uptime:  {uptime}',
        '',
        'Configuration',
        f'  Domain:       {domain_val}',
        f'  Prefix:       {PREFIX}',
        f'  HTTP port:    {HTTP_PORT}',
        f'  HTTPS port:   {HTTPS_PORT}',
        f'  Backend host: {BACKEND_HOST}',
        '',
        'TLS Certificate',
        f'  Mode:    {tls_mode}',
        f'  Path:    {TLS_CERT}',
        f'  Expires: {_cert_expiry()}',
        '',
        f'Active Routes ({len(routes)})',
    ]
    out += [f'  {r}' for r in routes] if routes else ['  (none)']
    out += [
        '',
        f'Event Log (last {len(events)})',
    ]
    out += [f'  {e}' for e in events] if events else ['  (none)']
    out.append('')

    tmp = STATUS_FILE + '.tmp'
    with open(tmp, 'w') as f:
        f.write('\n'.join(out))
    os.rename(tmp, STATUS_FILE)


# --- core ---

def reconfigure():
    before = os.path.getmtime(CONTROL_FILE) if os.path.exists(CONTROL_FILE) else None

    dump = subprocess.run(['dump-docker'], capture_output=True, text=True)
    if dump.returncode != 0:
        log(f'dump-docker error: {dump.stderr.strip()}')
        return
    subprocess.run(['reconfigure-nginx'], input=dump.stdout, text=True)

    after = os.path.getmtime(CONTROL_FILE) if os.path.exists(CONTROL_FILE) else None
    if before != after:
        routes = []
        if os.path.exists(CONTROL_FILE):
            with open(CONTROL_FILE) as f:
                routes = [l.strip() for l in f if l.strip()]
        log_event(f'routes updated ({len(routes)} active)')

    write_status()


def schedule_reconfigure():
    global _timer
    with _lock:
        if _timer is not None:
            _timer.cancel()
        _timer = threading.Timer(DEBOUNCE, reconfigure)
        _timer.start()


def run_nginx():
    while True:
        log('starting nginx')
        proc = subprocess.Popen(['nginx', '-g', 'daemon off;'])
        proc.wait()
        log(f'nginx exited (code {proc.returncode}), restarting in 1s')
        time.sleep(1)


def watch_events():
    while True:
        try:
            proc = subprocess.Popen(
                ['docker', 'events', '--format', '{{json .}}'],
                stdout=subprocess.PIPE, text=True,
            )
            log('watching docker events')
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if event.get('Type') != 'container':
                    continue
                if event.get('Action') not in TRIGGER_EVENTS:
                    continue
                attrs = event.get('Actor', {}).get('Attributes', {})
                if f'{PREFIX}.route' in attrs:
                    cid = event.get('Actor', {}).get('ID', '')[:12]
                    log(f'container {cid} {event["Action"]} — scheduling reconfigure')
                    schedule_reconfigure()
            proc.wait()
        except Exception as e:
            log(f'event watcher error: {e}')
        log('reconnecting to docker events in 5s')
        time.sleep(5)


# --- ACME ---

def acme_install():
    """Copy cert from acme.sh state into the paths nginx expects."""
    os.makedirs(os.path.dirname(TLS_CERT), exist_ok=True)
    result = subprocess.run([
        'acme.sh', '--install-cert',
        '-d', f'*.{ACME_DOMAIN}',
        '--home', ACME_HOME,
        '--cert-file',      TLS_CERT,
        '--key-file',       TLS_KEY,
        '--fullchain-file', TLS_CERT,
        '--reloadcmd',      'reload-nginx',
    ], capture_output=True, text=True)
    return result.returncode == 0 and os.path.exists(TLS_CERT)


def acme_issue():
    """Run the full DNS-01 challenge and issue a wildcard cert."""
    log(f'obtaining wildcard certificate for *.{ACME_DOMAIN} (provider: {ACME_PROVIDER})')
    cmd = [
        'acme.sh', '--issue',
        '--dns', f'dns_{ACME_PROVIDER}',
        '-d', f'*.{ACME_DOMAIN}',
        '-d', ACME_DOMAIN,
        '--home', ACME_HOME,
        '--server', ACME_CA,
    ]
    if ACME_EMAIL:
        cmd += ['--accountemail', ACME_EMAIL]
    result = subprocess.run(cmd)
    if result.returncode != 0:
        log('certificate issuance failed')
        return False
    if not acme_install():
        log('certificate installation failed')
        return False
    log('certificate obtained and installed')
    return True


def ensure_cert():
    """
    Fast path: restore from acme.sh state after a container restart.
    Slow path: full DNS-01 issuance on first run.
    """
    if os.path.exists(TLS_CERT) and os.path.exists(TLS_KEY):
        return True
    if acme_install():
        log('certificate restored from acme state')
        log_event('certificate restored from acme state')
        write_status()
        return True
    ok = acme_issue()
    if ok:
        log_event('certificate obtained via ACME')
        write_status()
    return ok


def run_renewal():
    """Periodically renew certs. acme.sh handles install and nginx reload via --reloadcmd."""
    while True:
        time.sleep(ACME_RENEW_INTERVAL)
        log('running certificate renewal check')
        result = subprocess.run(
            ['acme.sh', '--renew-all', '--home', ACME_HOME],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            log(f'renewal failed: {result.stderr.strip()}')
            log_event('certificate renewal failed')
        else:
            log('renewal check complete')
            log_event('certificate renewal check completed')
        write_status()


# --- startup ---

log('starting')
log_event('started')

if ACME_DOMAIN and ACME_PROVIDER:
    if not ensure_cert():
        log('could not obtain TLS certificate — exiting')
        sys.exit(1)
    threading.Thread(target=run_renewal, daemon=True).start()

threading.Thread(target=run_nginx, daemon=True).start()
reconfigure()
threading.Thread(target=watch_events, daemon=True).start()

try:
    while True:
        time.sleep(3600)
except KeyboardInterrupt:
    pass
