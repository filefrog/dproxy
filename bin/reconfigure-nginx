#!/usr/bin/python3
import json
import os
import os.path
import sys
import hashlib

def sha1_file(path):
  if os.path.exists(path):
    with open(path, 'rb') as f:
      return hashlib.file_digest(f, 'sha1').hexdigest()
  return ''

TLS_CERT = os.getenv('TLS_CERT', '/etc/nginx/tls/wildcard.crt')
TLS_KEY  = os.getenv('TLS_KEY',  '/etc/nginx/tls/wildcard.key')

DPROXY_DOMAIN = os.getenv('DPROXY_DOMAIN', '')
HTTP_PORT     = os.getenv('HTTP_PORT',     '80')
HTTPS_PORT    = os.getenv('HTTPS_PORT',    '443')
BACKEND_HOST  = os.getenv('BACKEND_HOST',  '127.0.0.1')
NGINX_CONFD   = os.getenv('NGINX_CONFD',   '/etc/nginx/conf.d')
STATE_DIR     = os.getenv('STATE_DIR',     '/var/run/dproxy')

os.makedirs(NGINX_CONFD, exist_ok=True)
os.makedirs(STATE_DIR,   exist_ok=True)

new_routes_file  = os.path.join(NGINX_CONFD, 'routes.conf.new')
cur_routes_file  = os.path.join(NGINX_CONFD, 'routes.conf')
new_control_file = os.path.join(STATE_DIR, 'control')
cur_control_file = os.path.join(STATE_DIR, 'last.control')

with open(new_routes_file, 'w') as routes:
  with open(new_control_file, 'w') as control:
    print('''
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}
''', file=routes)

    for line in sys.stdin:
      x = json.loads(line)
      id = x['id']
      config = x['config']

      headers = []
      for k in config:
        if k[:7] == 'header.':
          headers.append(f'add_header {k[7:]} "{config[k]}";')
      headers = "\n    ".join(headers)

      route = config.get('route', '')
      if DPROXY_DOMAIN and '.' not in route:
        config['route'] = f'{route}.{DPROXY_DOMAIN}'

      config['endpoint'] = f"{config['host'] if 'host' in config else BACKEND_HOST}:{config['port']}"

      print(f"https://{config['route']} -> {config['endpoint']} for [{id}]", file=control)
      print(f'''
server {{
  listen {HTTPS_PORT} ssl;
  server_name {config['route']};

  ssl_certificate     {TLS_CERT};
  ssl_certificate_key {TLS_KEY};
  include             /etc/nginx/tls.defaults;

  location / {{
    proxy_pass http://{config['endpoint']};
    include    /etc/nginx/proxy.defaults;
    {headers}
  }}
}}
''', file=routes)

    https_host = f'$host:{HTTPS_PORT}' if HTTPS_PORT != '443' else '$host'
    print(f'''
server {{
  listen {HTTP_PORT};
  server_name _;
  return 301 https://{https_host}$request_uri;
}}

server {{
  listen {HTTPS_PORT} ssl default_server deferred;
  server_name _;

  ssl_certificate     {TLS_CERT};
  ssl_certificate_key {TLS_KEY};
  include             /etc/nginx/tls.defaults;

  location / {{
    root         /etc/dproxy;
    try_files    /404.html =503;
    default_type text/html;
  }}
}}
''', file=routes)

cur_sha1 = sha1_file(cur_routes_file)
new_sha1 = sha1_file(new_routes_file)
if cur_sha1 == new_sha1:
  print(f'no changes detected ({cur_sha1})')
  os.unlink(new_routes_file)
  os.unlink(new_control_file)

else:
  print(f'updating nginx (to {new_sha1})...')
  os.rename(new_routes_file,  cur_routes_file)
  os.rename(new_control_file, cur_control_file)
  if os.getenv('SKIP_RELOAD', 'no') == 'yes':
    print('skipping reload of nginx (SKIP_RELOAD=yes)')
  else:
    os.system('reload-nginx')
